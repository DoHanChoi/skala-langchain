# LLM (a provider-standard OPENAI_API_KEY is also accepted)
MODEL_PROVIDER=openai
MODEL_ID=gpt-4o-mini
MODEL_API_KEY=

# Local-only PostgreSQL example credentials. Change them outside this demo.
POSTGRES_DB=rolelens
POSTGRES_USER=rolelens_owner
POSTGRES_PASSWORD=rolelens_local_owner
POSTGRES_AGENT_PASSWORD=rolelens_local_readonly
POSTGRES_HOST_PORT=55432
DATABASE_ADMIN_URL=postgresql+psycopg://rolelens_owner:rolelens_local_owner@127.0.0.1:55432/rolelens
DATABASE_READONLY_URL=postgresql+psycopg://rolelens_agent_ro:rolelens_local_readonly@127.0.0.1:55432/rolelens

# Reproducibility and safety
RANDOM_SEED=42
DATA_AS_OF=2026-09-15
SQL_STATEMENT_TIMEOUT_MS=10000
MAX_QUERY_ROWS=100
LOG_LEVEL=INFO
